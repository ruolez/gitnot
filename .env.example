# Infra secrets only; everything else is configured in the web UI.
# Generate with scripts/make-env.sh
SECRET_KEY=change-me
INTERNAL_TOKEN=change-me
POSTGRES_PASSWORD=change-me
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-me
# https://git.example.com (empty = from the request)
PUBLIC_URL=
# Host name and port shown in SSH clone URLs (empty = PUBLIC_URL's host)
SSH_HOST=
SSH_PORT=2222
APP_PORT=5564
# Largest single git push / release upload nginx accepts
MAX_UPLOAD=2g
