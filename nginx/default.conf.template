# ${MAX_UPLOAD} and ${INTERNAL_TOKEN} are filled in by the nginx image's envsubst at start.
# Containers are looked up through Docker's DNS on each request (cached 10 s), not once
# at start: a backend or git container that was recreated gets a new address.

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    resolver 127.0.0.11 valid=10s ipv6=off;

    client_max_body_size 1m;

    location ^~ /static/ {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }
    location = /favicon.ico { try_files /static/favicon.svg =404; default_type image/svg+xml; }
    location = /cli/gitnot { alias /usr/share/nginx/cli/gitnot; default_type text/plain; add_header Cache-Control "no-cache" always; }
    location = /robots.txt { return 200 "User-agent: *\nDisallow: /\n"; default_type text/plain; }

    location ^~ /api/ {
        # Release asset uploads: big bodies, streamed straight to the backend.
        location ~ ^/api/v1/repos/[^/]+/[^/]+/releases/[0-9]+/assets$ {
            client_max_body_size ${MAX_UPLOAD};
            proxy_request_buffering off;
            set $backend_up backend:5000; proxy_pass http://$backend_up;
            include /etc/nginx/mygit/stream.conf;
        }
        set $backend_up backend:5000; proxy_pass http://$backend_up;
        include /etc/nginx/mygit/proxy.conf;
    }

    # Release files: the backend checks access, then X-Accel-Redirects here.
    location ^~ /_releases/ {
        internal;
        alias /data/releases/;
        types { }
        default_type application/octet-stream;
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
        add_header X-Content-Type-Options nosniff always;
    }

    # ---- git over HTTPS: git-http-backend behind our authorization ----
    location ~ ^/[^/]+/[^/]+/(info/refs|git-upload-pack|git-receive-pack)$ {
        auth_request /_auth/git;
        auth_request_set $mg_path $upstream_http_x_mygit_path;
        auth_request_set $mg_user $upstream_http_x_mygit_user;
        auth_request_set $mg_user_id $upstream_http_x_mygit_user_id;
        auth_request_set $mg_repo_id $upstream_http_x_mygit_repo_id;
        error_page 403 = @git_denied;

        client_max_body_size ${MAX_UPLOAD};
        # git streams big pushes chunked; FastCGI needs a length, so nginx
        # spools the body first. Responses (clones) stream straight through.
        fastcgi_request_buffering on;
        fastcgi_buffering off;
        fastcgi_read_timeout 3600s;
        fastcgi_send_timeout 3600s;
        client_body_timeout 3600s;
        send_timeout 3600s;

        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /usr/lib/git-core/git-http-backend;
        fastcgi_param GIT_PROJECT_ROOT /data/repos;
        fastcgi_param PATH_INFO $mg_path;
        fastcgi_param REMOTE_USER $mg_user;
        fastcgi_param GIT_HTTP_EXPORT_ALL 1;
        fastcgi_param GIT_PROTOCOL $http_git_protocol;
        fastcgi_param GIT_HTTP_MAX_REQUEST_BUFFER 100M;
        fastcgi_param MYGIT_USER $mg_user;
        fastcgi_param MYGIT_USER_ID $mg_user_id;
        fastcgi_param MYGIT_REPO_ID $mg_repo_id;
        fastcgi_param MYGIT_VIA http;
        fastcgi_param PATH /usr/local/bin:/usr/bin:/bin;
        fastcgi_param HOME /home/git;
        set $git_up git:9000;
        fastcgi_pass $git_up;
    }

    # Web pages. Every page is one static HTML file whose script reads the path.
    location = / { include /etc/nginx/mygit/page.conf; try_files /index.html =404; }
    location ~ ^/(login|explore|new)/?$ { include /etc/nginx/mygit/page.conf; try_files /$1.html =404; }
    location ~ ^/settings(/.*)?$ { include /etc/nginx/mygit/page.conf; try_files /settings.html =404; }
    location ~ ^/-/admin(/.*)?$ { include /etc/nginx/mygit/page.conf; try_files /admin.html =404; }

    location = /_auth/git {
        internal;
        set $backend_up backend:5000;
        proxy_pass http://$backend_up/internal/git-auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    location @git_denied {
        rewrite ^ /internal/git-denied break;
        set $backend_up backend:5000; proxy_pass http://$backend_up;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    location ^~ /internal/ { return 404; }

    include /etc/nginx/mygit/routes.d/*.conf;

    # Raw files and archives (also what installers curl).
    location ^~ /raw/ { set $backend_up backend:5000; proxy_pass http://$backend_up; include /etc/nginx/mygit/stream.conf; }
    location ~ ^/[^/]+/[^/]+/(raw|archive|releases/download|releases/latest/download)/ { set $backend_up backend:5000; proxy_pass http://$backend_up; include /etc/nginx/mygit/stream.conf; }

    # Git LFS clients get a clear answer instead of a web page.
    location ~ ^/[^/]+/[^/]+/info/lfs/ {
        default_type application/vnd.git-lfs+json;
        return 501 '{"message":"git-Not does not support Git LFS. Put large files in a release instead."}\n';
    }

    # A browser opening a clone URL lands on the repository page.
    location ~ ^/([^/]+)/([^/]+)\.git/?$ { return 301 /$1/$2; }
    location ~ ^/[^/]+/?$ { include /etc/nginx/mygit/page.conf; try_files /owner.html =404; }
    location ~ ^/[^/]+/[^/]+(/.*)?$ { include /etc/nginx/mygit/page.conf; try_files /repo.html =404; }

    location / { return 404; }
}
