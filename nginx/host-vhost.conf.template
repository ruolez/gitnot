# Host-level vhost for the shared reverse proxy (github.com/ruolez/shared-proxy).
# install.sh renders it to /etc/nginx/sites-available/mygit.conf, replacing __DOMAIN__
# and __PORT__; don't edit the rendered file. It only terminates TLS: limits, routing
# and auth live in the container's nginx (nginx/default.conf.template).

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    include snippets/shared-proxy-acme.conf;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # "listen ... http2" rather than "http2 on": Ubuntu 24.04 ships nginx 1.24.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    include snippets/shared-proxy-tls.conf;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # git pushes, clones and release files can be gigabytes and take a long time. The
    # container enforces the size limit (MAX_UPLOAD); here everything streams straight
    # through, so nothing is spooled to this host's disk twice.
    client_max_body_size 0;
    client_body_timeout 3600s;
    proxy_connect_timeout 10s;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_max_temp_file_size 0;

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        include snippets/shared-proxy-headers.conf;
    }
}
