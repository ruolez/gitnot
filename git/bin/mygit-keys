#!/usr/bin/env python3
"""sshd AuthorizedKeysCommand: prints the authorized_keys line (with its
forced command) for the offered key, or nothing."""

import sys
import urllib.parse
import urllib.request


def main():
    if len(sys.argv) != 3 or sys.argv[1] != "git":
        return 0
    with open("/etc/mygit/internal-token") as f:
        token = f.read().strip()
    with open("/etc/mygit/backend-url") as f:
        base = f.read().strip()
    url = f"{base}/internal/ssh/key?fp={urllib.parse.quote(sys.argv[2])}"
    req = urllib.request.Request(url, headers={"X-Internal-Token": token})
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            sys.stdout.write(resp.read().decode())
    except Exception as e:  # noqa: BLE001 - sshd treats any failure as "no key"
        print(f"mygit-keys: {e}", file=sys.stderr)
    return 0


sys.exit(main())
